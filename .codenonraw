-- StarterGui..dll Internal.exe.UI.y
local function C_3()
local script = G2L["3"];
	local frame = script.Parent
	
	frame.Visible = false
	if frame:IsA("GuiButton") then
		frame.Interactable = false
	end
	if frame:IsA("GuiObject") then
		frame.Active = false
		frame.Selectable = false
	end
end;
task.spawn(C_3);
-- StarterGui..dll Internal.exe.UI.Bar3.Options.LocalScript
local function C_d()
local script = G2L["d"];
	local button = script.Parent
	
	local parent = button.Parent
	if not parent then
		warn("Button has no parent: " .. button:GetFullName())
		return
	end
	
	local grandparent = parent.Parent
	local greatGrandparent = grandparent and grandparent.Parent
	
	-- parent's parent's sibling (child of great-grandparent)
	local options = (greatGrandparent and greatGrandparent:FindFirstChild("Options"))
		or (grandparent and grandparent:FindFirstChild("Options"))
		or parent:FindFirstChild("Options")
	
	if not options then
		warn("Options not found under " .. (greatGrandparent and greatGrandparent:GetFullName() or parent:GetFullName()))
		return
	end
	
	local function setInteractable(obj, enabled)
		if obj:IsA("GuiButton") then
			obj.Interactable = enabled
			obj.Selectable = enabled
		end
		if obj:IsA("GuiObject") then
			obj.Active = enabled
		end
	end
	
	button.Activated:Connect(function()
		options.Visible = true
		options.Interactable = true
		setInteractable(options, true)
		for _, obj in ipairs(options:GetDescendants()) do
			setInteractable(obj, true)
		end
	end)
end;
task.spawn(C_d);
-- StarterGui..dll Internal.exe.UI.ScrollingFrame.TextBox.MainEditorScript
local function C_15()
local script = G2L["15"];
	local textBox = script.Parent
	local parentFrame = textBox.Parent
	
	local RunService = game:GetService("RunService")
	local TextService = game:GetService("TextService")
	
	---------------------------------------------------
	-- TEXTBOX SETUP
	---------------------------------------------------
	
	textBox.ClearTextOnFocus = false
	textBox.MultiLine = true
	textBox.TextWrapped = false
	textBox.Font = Enum.Font.Code
	textBox.TextXAlignment = Enum.TextXAlignment.Left
	textBox.TextYAlignment = Enum.TextYAlignment.Top
	textBox.BackgroundTransparency = 1
	textBox.BorderSizePixel = 0
	
	textBox.TextTransparency = 1
	textBox.ZIndex = 2
	
	textBox.TextSize = 17
	textBox:GetPropertyChangedSignal("TextSize"):Connect(function()
		textBox.TextSize = 17
	end)
	
	textBox.Position = UDim2.new(0, 40, 0, 0)
	textBox.Size = UDim2.new(1, -40, 1, 0)
	
	if textBox.Text == "" then
		textBox.Text = 'print("Hello world!")'
	end
	
	---------------------------------------------------
	-- LINE NUMBERS
	---------------------------------------------------
	
	local lineNumbers = parentFrame:FindFirstChild("LineNumbers")
	if not lineNumbers then
		lineNumbers = Instance.new("TextLabel")
		lineNumbers.Name = "LineNumbers"
		lineNumbers.Parent = parentFrame
	
		lineNumbers.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		lineNumbers.BorderSizePixel = 0
		lineNumbers.Position = UDim2.new(0, 0, 0, 0)
		lineNumbers.Size = UDim2.new(0, 40, 1, 0)
	
		lineNumbers.Font = Enum.Font.Code
		lineNumbers.TextSize = 17
		lineNumbers.TextColor3 = Color3.fromRGB(170, 170, 170)
	
		lineNumbers.TextXAlignment = Enum.TextXAlignment.Center
		lineNumbers.TextYAlignment = Enum.TextYAlignment.Top
		lineNumbers.TextWrapped = false
	end
	
	lineNumbers:GetPropertyChangedSignal("TextSize"):Connect(function()
		lineNumbers.TextSize = 17
	end)
	
	---------------------------------------------------
	-- SYNTAX OVERLAY
	---------------------------------------------------
	
	local overlay = parentFrame:FindFirstChild("SyntaxOverlay")
	if not overlay then
		overlay = Instance.new("TextLabel")
		overlay.Name = "SyntaxOverlay"
		overlay.Parent = parentFrame
	end
	
	overlay.BackgroundTransparency = 1
	overlay.Font = Enum.Font.Code
	overlay.TextSize = 17
	overlay.RichText = true
	overlay.TextXAlignment = Enum.TextXAlignment.Left
	overlay.TextYAlignment = Enum.TextYAlignment.Top
	overlay.Position = UDim2.new(0, 40, 0, 0)
	overlay.Size = UDim2.new(1, -40, 1, 0)
	overlay.TextWrapped = false
	overlay.TextColor3 = Color3.fromRGB(255, 255, 255)
	overlay.ZIndex = 1
	overlay.Active = false
	
	---------------------------------------------------
	-- MANUAL CARET (native one is hidden under overlay)
	---------------------------------------------------
	
	local caret = parentFrame:FindFirstChild("ManualCaret")
	if not caret then
		caret = Instance.new("Frame")
		caret.Name = "ManualCaret"
		caret.Parent = parentFrame
	end
	
	caret.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	caret.BorderSizePixel = 0
	caret.Size = UDim2.fromOffset(2, 17)
	caret.ZIndex = 3
	caret.Active = false
	caret.Visible = false
	
	local blink = 0
	local showCaret = true
	
	local function updateCaret()
		if not textBox:IsFocused() then
			caret.Visible = false
			return
		end
	
		local cursor = textBox.CursorPosition
		if cursor < 0 then
			caret.Visible = false
			return
		end
	
		local before = string.sub(textBox.Text, 1, math.max(cursor - 1, 0))
		local line = 1
		for _ in string.gmatch(before, "\n") do
			line += 1
		end
		local prefix = before:match("[^\n]*$") or ""
		local w = TextService:GetTextSize(prefix, 17, Enum.Font.Code, Vector2.new(10000, 20)).X
		local h = TextService:GetTextSize("Ag", 17, Enum.Font.Code, Vector2.new(10000, 20)).Y
	
		caret.Position = UDim2.new(0, 40 + w, 0, (line - 1) * h)
		caret.Visible = showCaret
	end
	
	---------------------------------------------------
	-- CANVAS RESIZE
	---------------------------------------------------
	
	local function updateCanvas()
		local textHeight = textBox.TextBounds.Y + 20
	
		if parentFrame:IsA("ScrollingFrame") then
			parentFrame.CanvasSize = UDim2.new(0, 0, 0, textHeight)
		end
	end
	
	---------------------------------------------------
	-- LINE NUMBERS UPDATE
	---------------------------------------------------
	
	local function updateLineNumbers()
		local lines = 1
		for _ in string.gmatch(textBox.Text, "\n") do
			lines += 1
		end
	
		local out = ""
		for i = 1, lines do
			out ..= i .. "\n"
		end
	
		lineNumbers.Text = out
	end
	
	---------------------------------------------------
	-- SYNTAX HIGHLIGHTING
	---------------------------------------------------
	
	local C_KEYWORD = "#569CD6"
	local C_CUSTOM = "#4FC1FF"
	local C_ROBLOX = "#4EC9B0"
	local C_STRING = "#A2E875"
	local C_NUMBER = "#B5CEA8"
	local C_COMMENT = "#6A9955"
	local C_FUNC = "#DCDCAA"
	
	local keywords = {
		["local"] = true, ["function"] = true, ["end"] = true,
		["if"] = true, ["then"] = true, ["else"] = true, ["elseif"] = true,
		["for"] = true, ["while"] = true, ["do"] = true, ["repeat"] = true,
		["until"] = true, ["return"] = true, ["break"] = true, ["continue"] = true,
		["and"] = true, ["or"] = true, ["not"] = true, ["in"] = true,
		["nil"] = true, ["true"] = true, ["false"] = true,
	}
	
	local customGlobals = {
		["syn"] = true, ["getgenv"] = true, ["getrenv"] = true,
		["getrawmetatable"] = true, ["getnamecallmethod"] = true,
		["fireclickdetector"] = true, ["fireproximityprompt"] = true,
		["firesignal"] = true, ["hookfunction"] = true, ["hookmetamethod"] = true,
		["newcclosure"] = true, ["setreadonly"] = true, ["isreadonly"] = true,
		["getupvalue"] = true, ["setupvalue"] = true, ["getconstants"] = true,
		["getinfo"] = true, ["checkcaller"] = true, ["identifyexecutor"] = true,
		["setclipboard"] = true, ["gethui"] = true, ["request"] = true,
	}
	
	local robloxGlobals = {
		["game"] = true, ["workspace"] = true, ["script"] = true,
		["plugin"] = true, ["shared"] = true, ["Enum"] = true,
		["Instance"] = true, ["task"] = true, ["Vector3"] = true,
		["Vector2"] = true, ["CFrame"] = true, ["Color3"] = true,
		["UDim2"] = true, ["UDim"] = true, ["BrickColor"] = true,
		["TweenInfo"] = true, ["NumberRange"] = true, ["NumberSequence"] = true,
		["ColorSequence"] = true, ["Rect"] = true, ["Ray"] = true,
		["Region3"] = true, ["Random"] = true, ["DateTime"] = true,
		["PhysicalProperties"] = true, ["Faces"] = true, ["Axes"] = true,
	}
	
	local function esc(s)
		s = string.gsub(s, "&", "&amp;")
		s = string.gsub(s, "<", "&lt;")
		s = string.gsub(s, ">", "&gt;")
		return s
	end
	
	local function tag(color, s)
		return '<font color="' .. color .. '">' .. esc(s) .. "</font>"
	end
	
	local function highlightLuau(text)
		local out = {}
		local pos = 1
		local n = #text
		local lastSig = ""
		local prevWord = nil
	
		local function push(s)
			out[#out + 1] = s
		end
	
		while pos <= n do
			local c = text:sub(pos, pos)
	
			if c == " " or c == "\t" or c == "\n" or c == "\r" then
				push(c)
				pos += 1
	
			elseif text:sub(pos, pos + 3) == "--[[" then
				local close = string.find(text, "]]", pos + 4, true)
				if close then
					push(tag(C_COMMENT, text:sub(pos, close + 1)))
					pos = close + 2
				else
					push(tag(C_COMMENT, text:sub(pos)))
					break
				end
				lastSig = "]"
				prevWord = nil
	
			elseif text:sub(pos, pos + 1) == "--" then
				local nl = string.find(text, "\n", pos + 2, true)
				if nl then
					push(tag(C_COMMENT, text:sub(pos, nl - 1)))
					push("\n")
					pos = nl + 1
				else
					push(tag(C_COMMENT, text:sub(pos)))
					break
				end
				lastSig = "\n"
				prevWord = nil
	
			elseif text:sub(pos, pos + 1) == "[[" then
				local close = string.find(text, "]]", pos + 2, true)
				if close then
					push(tag(C_STRING, text:sub(pos, close + 1)))
					pos = close + 2
				else
					push(tag(C_STRING, text:sub(pos)))
					break
				end
				lastSig = "]"
				prevWord = nil
	
			elseif c == '"' or c == "'" then
				local i = pos + 1
				local closed = false
				while i <= n do
					local ch = text:sub(i, i)
					if ch == "\\" then
						i += 2
					elseif ch == c then
						closed = true
						break
					elseif ch == "\n" then
						break
					else
						i += 1
					end
				end
				if closed then
					push(tag(C_STRING, text:sub(pos, i)))
					pos = i + 1
				else
					push(tag(C_STRING, text:sub(pos, i - 1)))
					pos = i
				end
				lastSig = c
				prevWord = nil
	
			elseif c:match("%d") or (c == "." and text:sub(pos + 1, pos + 1):match("%d")) then
				local rest = text:sub(pos)
				local num = rest:match("^0[xX]%x+")
					or rest:match("^%d*%.?%d+[eE][+-]?%d+")
					or rest:match("^%d*%.?%d+")
				push(tag(C_NUMBER, num))
				pos += #num
				lastSig = num:sub(-1)
				prevWord = nil
	
			elseif c:match("[%a_]") then
				local word = text:match("^[%a_][%w_]*", pos)
				local isMethod = (lastSig == "." or lastSig == ":")
				local color = nil
				if isMethod then
					color = C_FUNC
				elseif keywords[word] then
					color = C_KEYWORD
				elseif customGlobals[word] then
					color = C_CUSTOM
				elseif robloxGlobals[word] then
					color = C_ROBLOX
				elseif prevWord == "function" then
					color = C_FUNC
				else
					local j = pos + #word
					while j <= n and (text:sub(j, j) == " " or text:sub(j, j) == "\t") do
						j += 1
					end
					if text:sub(j, j) == "(" then
						color = C_FUNC
					end
				end
				if color then
					push(tag(color, word))
				else
					push(esc(word))
				end
				pos += #word
				lastSig = word:sub(-1)
				if isMethod then
					prevWord = nil
				else
					prevWord = word
				end
	
			else
				push(esc(c))
				pos += 1
				lastSig = c
				prevWord = nil
			end
		end
	
		return table.concat(out)
	end
	
	---------------------------------------------------
	-- MAIN LOOP
	---------------------------------------------------
	
	print("[CodeEditor] running: " .. textBox:GetFullName())
	
	RunService.RenderStepped:Connect(function(dt)
		blink += dt
		if blink >= 0.5 then
			blink = 0
			showCaret = not showCaret
		end
		updateCaret()
	
		local ok, result = pcall(highlightLuau, textBox.Text)
		if ok then
			overlay.Text = result
		else
			warn("[CodeEditor] highlight failed: " .. tostring(result))
		end
		updateLineNumbers()
		updateCanvas()
	end)
	
	---------------------------------------------------
	-- BAR 3 BUTTONS (Clear / Execute)
	---------------------------------------------------
	
	local barParent = parentFrame.Parent
	local bar = barParent and (barParent:FindFirstChild("Bar3") or barParent:FindFirstChild("Bar 3"))
	
	if not bar then
		warn("[CodeEditor] Bar 3 not found under " .. tostring(barParent and barParent:GetFullName()))
	else
		local clearBtn = bar:FindFirstChild("Clear")
		if clearBtn and clearBtn:IsA("GuiButton") then
			clearBtn.Activated:Connect(function()
				textBox.Text = ""
			end)
		end
	
		local attached = false
	
		local attachBtn = bar:FindFirstChild("Attatch") or bar:FindFirstChild("Attach")
		if attachBtn and attachBtn:IsA("GuiButton") then
			attachBtn.Activated:Connect(function()
				if attached then
					pcall(function()
						game:GetService("StarterGui"):SetCore("SendNotification", {
							Title = "Attach Error";
							Text = "You are already attached";
							Button1 = "Okay";
							Duration = 5;
						})
					end)
					return
				end
				attached = true
			end)
		end
	
		local execBtn = bar:FindFirstChild("Execute")
		if execBtn and execBtn:IsA("GuiButton") then
			execBtn.Activated:Connect(function()
				if not attached then
					pcall(function()
						game:GetService("StarterGui"):SetCore("SendNotification", {
							Title = "Execution Error";
							Text = "You must attach the client inorder to execute";
							Button1 = "Okay";
							Duration = 5;
						})
					end)
					return
				end
				local chunk, compileErr
				local okLoad, loadErr = pcall(function()
					chunk, compileErr = loadstring(textBox.Text)
				end)
				if not okLoad then
					warn("[CodeEditor] loadstring unavailable: " .. tostring(loadErr))
					return
				end
				if not chunk then
					warn("[CodeEditor] compile error: " .. tostring(compileErr))
					return
				end
	
				--line 442
				local okRun, runErr = pcall(chunk)
				if not okRun then
					warn("[CodeEditor] runtime error: " .. tostring(runErr))
				end
			end)
		end
	end
end;
task.spawn(C_15);
