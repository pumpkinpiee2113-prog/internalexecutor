-- StarterGui..dll Internal.exe.UI.CheckforLoadingf
local function C_5()
local script = G2L["5"];
	task.wait(2)
	
	local frame = script.Parent
	local parent = frame.Parent
	
	if not parent then
		warn("Frame has no parent: " .. frame:GetFullName())
		return
	end
	
	local loading = parent:FindFirstChild("Loading")
	if not loading then
		warn("Loading not found under " .. parent:GetFullName())
		return
	end
	
	local function loadingIsOff()
		if loading.Visible then
			return false
		end
		if loading.Active then
			return false
		end
		if loading:IsA("GuiButton") and loading.Interactable then
			return false
		end
		return true
	end
	
	local function setOn(obj, enabled)
		obj.Visible = enabled
		if obj:IsA("GuiButton") then
			obj.Interactable = enabled
		end
		if obj:IsA("GuiObject") then
			obj.Active = enabled
			obj.Selectable = enabled
		end
	end
	
	local function check()
		if loadingIsOff() then
			setOn(frame, true)
		end
	end
	
	loading:GetPropertyChangedSignal("Visible"):Connect(check)
	loading:GetPropertyChangedSignal("Active"):Connect(check)
	if loading:IsA("GuiButton") then
		loading:GetPropertyChangedSignal("Interactable"):Connect(check)
	end
	
	check()
end;
task.spawn(C_5);
-- StarterGui..dll Internal.exe.UI.Bar3.Options.LocalScript
local function C_f()
local script = G2L["f"];
	local button = script.Parent
	
	local parent = button.Parent
	if not parent then
		warn("Button has no parent: " .. button:GetFullName())
		return
	end
	
	local grandparent = parent.Parent
	local greatGrandparent = grandparent and grandparent.Parent
	
	-- parent's parent's sibling (child of great-grandparent)
	local options = (greatGrandparent and greatGrandparent:FindFirstChild("Options"))
		or (grandparent and grandparent:FindFirstChild("Options"))
		or parent:FindFirstChild("Options")
	
	if not options then
		warn("Options not found under " .. (greatGrandparent and greatGrandparent:GetFullName() or parent:GetFullName()))
		return
	end
	
	local function setInteractable(obj, enabled)
		if obj:IsA("GuiButton") then
			obj.Interactable = enabled
			obj.Selectable = enabled
		end
		if obj:IsA("GuiObject") then
			obj.Active = enabled
		end
	end
	
	button.Activated:Connect(function()
		options.Visible = true
		options.Interactable = true
		setInteractable(options, true)
		for _, obj in ipairs(options:GetDescendants()) do
			setInteractable(obj, true)
		end
	end)
end;
task.spawn(C_f);
